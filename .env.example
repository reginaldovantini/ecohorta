# =====================================================================
# EcoHorta Inteligente — variáveis de ambiente
#
# 1. Copie este arquivo para .env.local
# 2. Preencha os valores (painel do Supabase e comandos indicados)
# 3. NUNCA versione o .env.local (já está no .gitignore)
#
# Variáveis NEXT_PUBLIC_* são enviadas ao navegador: nunca coloque
# segredos nelas. Na Vercel, cadastre as variáveis do bloco "Servidor"
# em Project Settings > Environment Variables.
# =====================================================================

# ---------- Aplicação ---------------------------------------------------

# URL pública do app — usada nos QR Codes e links.
# Produção: https://<seu-projeto>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase (servidor + navegador) ----------------------------
# Painel do Supabase > Project Settings > API Keys

NEXT_PUBLIC_SUPABASE_URL=
# Chave "publishable" (sb_publishable_...). Segura para o navegador: o acesso é limitado pelo RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave "secret" (sb_secret_...). SOMENTE scripts de administração (criar contas). Ignora o RLS:
# nunca expor no navegador. O app em produção não precisa dela — não cadastre na Vercel.
SUPABASE_SECRET_KEY=

# Banco de dados — Painel > Connect > Connection string (substitua [YOUR-PASSWORD]).
# Aplicação e Vercel: "Transaction pooler" (porta 6543).
DATABASE_URL=
# Migrations e scripts de administração (apenas local): "Session pooler" (porta 5432).
DATABASE_MIGRATION_URL=

# Domínio sintético, não roteável, das contas de estudante (o estudante não tem e-mail).
STUDENT_EMAIL_DOMAIN=alunos.ecohorta.invalid

# ---------- IoT ------------------------------------------------------------

# Segredo usado no hash dos tokens dos dispositivos (mínimo 32 caracteres aleatórios).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor invalida todos os tokens de dispositivos.
IOT_TOKEN_PEPPER=

# Token do dispositivo virtual EC-001 (SIMULAÇÃO). Gerado por `npm run db:seed`;
# o banco guarda somente o hash. Não precisa ir para a Vercel.
IOT_SIMULATED_DEVICE_TOKEN=

# Para onde o dispositivo virtual envia telemetria (padrão: http://localhost:3000).
# Para testar o deploy: https://<seu-projeto>.vercel.app
ECOHORTA_API_URL=

# ---------- Teste de ponta a ponta (npm run smoke) — apenas local ----------
# Contas de TESTE criadas com `npm run admin -- create-user`.

SMOKE_BASE_URL=
SMOKE_STUDENT_CODE=
SMOKE_STUDENT_PIN=
SMOKE_TEACHER_EMAIL=
SMOKE_TEACHER_PASSWORD=

# ---------- Notificações Web Push (futuro) ----------------------------------
# Gerar: npx web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@suaescola.exemplo
