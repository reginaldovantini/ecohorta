# =====================================================================
# EcoHorta Inteligente — variáveis de ambiente
#
# 1. Copie este arquivo para .env.local
# 2. Preencha somente o bloco da etapa em que o projeto está
# 3. NUNCA versione o .env.local (já está no .gitignore)
#
# Variáveis NEXT_PUBLIC_* são enviadas ao navegador: nunca coloque
# segredos nelas. Na Vercel, cadastre as mesmas variáveis em
# Project Settings > Environment Variables.
# =====================================================================

# ---------- Aplicação (necessário desde já) --------------------------

# URL pública do app — usada nos QR Codes e links.
# Produção: https://<seu-projeto>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fonte dos dados do captador:
#   simulation -> dispositivo virtual (a interface exibe "SIMULAÇÃO")
#   supabase   -> dados reais do ESP32 via Supabase (disponível a partir dos Dias 6–9)
NEXT_PUBLIC_DATA_SOURCE=simulation

# ---------- Supabase (Dias 6–7) ---------------------------------------
# Painel do Supabase > Project Settings > API Keys

NEXT_PUBLIC_SUPABASE_URL=
# Chave "publishable" (sb_publishable_...). Segura para o navegador: o acesso é limitado pelo RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave "secret" (sb_secret_...). SOMENTE servidor. Ignora o RLS — nunca expor no navegador.
SUPABASE_SECRET_KEY=

# ---------- IoT / ESP32 (Dias 8–9) ------------------------------------

# Segredo usado para gerar o hash dos tokens dos dispositivos (mínimo 32 caracteres aleatórios).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IOT_TOKEN_PEPPER=

# ---------- Notificações Web Push (Dia 18) ----------------------------
# Gerar: npx web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@suaescola.exemplo
